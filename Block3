### Задание 3
SELECT
    account.client_id
FROM account
LEFT JOIN transaction
ON account.id = transaction.account_id
  AND transaction.type = 'buy'        -- Непонятно как именно называется тип покупки, но допустим buy
  AND transaction.transaction_date <= CURRENT_DATE - INTERVAL '1 month'
GROUP BY account.client_id
HAVING COALESCE(SUM(transaction.amount), 0) < 5000;
